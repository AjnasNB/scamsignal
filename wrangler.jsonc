{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scamsignal",
  "main": "./worker/index.ts",
  "account_id": "4fd82676dc0328c3ae8812138409e980",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "routes": [{"pattern":"scamsignal.ajnasnb.com","custom_domain":true}],
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/arkiv-rpc"]
  },
  "secrets": { "required": ["ARKIV_API_KEY"] },
  "ratelimits": [{
    "name": "RPC_RATE_LIMITER",
    "namespace_id": "761467312",
    "simple": { "limit": 60, "period": 60 }
  }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
